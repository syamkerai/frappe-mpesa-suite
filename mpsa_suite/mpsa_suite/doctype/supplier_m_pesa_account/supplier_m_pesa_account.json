 "fields": [
  {
   "fieldname": "supplier",
   "fieldtype": "Link",
   "label": "Supplier",
   "options": "Supplier",
   "reqd": 1,
   "in_list_view": 1,
   "in_standard_filter": 1,
   "search_index": 1
  },
  {
   "fieldname": "supplier_name",
   "fieldtype": "Data",
   "label": "Supplier Name",
   "fetch_from": "supplier.supplier_name",
   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "account_type",
   "fieldtype": "Select",
   "label": "Account Type",
   "options": "Phone (B2C)\nPaybill\nTill (Buy Goods)\nBank Account (via Bank Paybill)",
   "reqd": 1,
   "default": "Paybill",
   "in_list_view": 1,
   "description": "Phone (B2C): paid to an M-Pesa line. Paybill: a business paybill with the account number it gave you. Till (Buy Goods): a till number. Bank Account (via Bank Paybill): paid to an account at a bank through the bank's M-Pesa paybill, picked from M-Pesa Bank Paybills."
  },
  {
   "fieldname": "phone",
   "fieldtype": "Data",
   "label": "M-Pesa Phone Number",
   "depends_on": "eval:doc.account_type==\"Phone (B2C)\"",
   "mandatory_depends_on": "eval:doc.account_type==\"Phone (B2C)\"",
   "search_index": 1,
   "in_list_view": 1,
   "description": "The Safaricom line registered in the supplier's name, e.g. 0722 000 000."
  },
  {
   "fieldname": "bank_paybill",
   "fieldtype": "Link",
   "label": "Bank",
   "options": "M-Pesa Bank Paybill",
   "depends_on": "eval:doc.account_type==\"Bank Account (via Bank Paybill)\"",
   "mandatory_depends_on": "eval:doc.account_type==\"Bank Account (via Bank Paybill)\"",
   "search_index": 1,
   "description": "The bank, microfinance bank or Sacco the account is at. Its paybill is copied below."
  },
  {
   "fieldname": "shortcode",
   "fieldtype": "Data",
   "label": "Paybill / Till Number",
   "in_list_view": 1,
   "search_index": 1,
   "description": "Paybill or till: exactly as given in writing, digits only. Bank account: the bank's paybill, copied from the bank.",
   "depends_on": "eval:doc.account_type!=\"Phone (B2C)\"",
   "mandatory_depends_on": "eval:doc.account_type==\"Paybill\" || doc.account_type==\"Till (Buy Goods)\"",
   "read_only_depends_on": "eval:doc.account_type==\"Bank Account (via Bank Paybill)\""
  },
  {
   "fieldname": "account_number",
   "fieldtype": "Data",
   "label": "Account Number",
   "depends_on": "eval:doc.account_type==\"Paybill\" || doc.account_type==\"Bank Account (via Bank Paybill)\"",
   "mandatory_depends_on": "eval:doc.account_type==\"Paybill\" || doc.account_type==\"Bank Account (via Bank Paybill)\"",
   "description": "Paybill: the account number the business told you to use. Bank account: the account number at that bank, exactly as the bank wants it with its paybill."
  },
  {
   "fieldname": "account_holder_name",
   "fieldtype": "Data",
   "label": "Account Holder Name",
   "depends_on": "eval:doc.account_type==\"Bank Account (via Bank Paybill)\"",
   "mandatory_depends_on": "eval:doc.account_type==\"Bank Account (via Bank Paybill)\"",
   "description": "Whose account it is at the bank, as on the proof (the supplier's name when left empty). M-Pesa does not show it: the proof and the approver confirm it."
  },
  {
   "fieldname": "bank",
   "fieldtype": "Link",
   "label": "ERPNext Bank",
   "options": "Bank",
   "fetch_from": "bank_paybill.bank",
   "read_only": 1,
   "depends_on": "eval:doc.bank"
  },
  {
   "fieldname": "column_break_main",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "expected_name",
   "fieldtype": "Data",
   "label": "Name M-Pesa Shows",
   "description": "Phone: the name the line is registered in. Paybill or till: the business name M-Pesa shows for the number. Bank account: the bank's name as M-Pesa shows it, copied from the bank (M-Pesa names the bank, not the account holder). Every payment is checked against it.",
   "mandatory_depends_on": "eval:doc.account_type!=\"Bank Account (via Bank Paybill)\"",
   "read_only_depends_on": "eval:doc.account_type==\"Bank Account (via Bank Paybill)\""
  },
  {
   "fieldname": "is_default",
   "fieldtype": "Check",
   "label": "Default for This Supplier",
   "allow_on_submit": 1,
   "read_only_depends_on": "eval:doc.docstatus==1",
   "description": "Where salaries and payments that name no account go. Once approved, change it with Make Default."
  },
  {
   "fieldname": "proof",
   "fieldtype": "Attach",
